APP_NAME="ABV-IIITM Alumni Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8090
# Set to true behind HTTPS: enables HSTS, secure cookies and https:// URLs.
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker service names; see compose.yaml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=alumni_connect
DB_USERNAME=alumni
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Database sessions let users list and revoke their active devices (SRS 16).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=alumni_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches all mail in development: http://localhost:8027
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alumni@iiitm.ac.in"
MAIL_FROM_NAME="${APP_NAME}"

# First super administrator, created by the seeder. Change the password on
# first sign-in; 2FA enrolment is enforced before any admin page opens.
SEED_ADMIN_EMAIL=admin@iiitm.ac.in
SEED_ADMIN_PASSWORD="ChangeMe-Alumni-2026"

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5174

# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-*.
# Leave empty unless a proxy actually sits in front of nginx.
TRUSTED_PROXIES=

# Sign in with Google / LinkedIn: each provider appears once its keys are set.
# Callback URLs: ${APP_URL}/auth/google/callback and ${APP_URL}/auth/linkedin-openid/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Restrict /admin to these IPs/CIDRs (e.g. the campus range). Empty = no restriction.
ADMIN_ALLOWED_IPS=
# Email on sign-in from a new browser: privileged | all | off
LOGIN_ALERTS=privileged

# Malware scanning for uploads (SRS 71). `docker compose --profile scan up -d clamav`
# starts a local clamd; then set CLAMAV_HOST=clamav. Production: UPLOADS_SCAN_REQUIRED=true.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOADS_SCAN_REQUIRED=false

# Donations (SRS 45-47): fake = local test checkout; razorpay = hosted Payment Links.
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RECEIPT_INSTITUTION_PAN=
RECEIPT_80G_REGISTRATION=

# Optional AI layer (SRS 96): natural-language search, AI mentor ranking, assistant.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
